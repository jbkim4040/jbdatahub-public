# ==============================================
# .env 파일을 이 파일을 복사해서 만드세요
# cp .env.example .env
# .env 는 절대 Git에 올리지 마세요!
# ==============================================

# ── 백엔드 DB ──────────────────────────────
DB_URL=jdbc:postgresql://your-db-host:5432/postgres
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── 공공데이터 API ─────────────────────────
PUBLIC_API_BASE_URL=https://api.odcloud.kr/api
PUBLIC_API_PATH=/15077093/v1/open-data-list
PUBLIC_API_SERVICE_KEY=your_service_key_here
