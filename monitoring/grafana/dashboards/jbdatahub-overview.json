    },
    {
      "type": "stat",
      "title": "Request Rate (req/s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "id": 1,
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"jbdatahub\"}[1m]))",
          "refId": "A",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 100, "color": "yellow"}, {"value": 500, "color": "red"}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "type": "stat",
      "title": "5xx Error Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "id": 2,
      "gridPos": {"x": 6, "y": 1, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"jbdatahub\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"jbdatahub\"}[5m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.01, "color": "yellow"}, {"value": 0.05, "color": "red"}]}
        }
      },
      "options": {"colorMode": "background"}
    },
    {
      "type": "stat",
      "title": "p95 Latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
